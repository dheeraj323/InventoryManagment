rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'ADMIN' ||
        request.auth.token.role == 'ADMIN'
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        getUserData().role == 'STAFF' ||
        request.auth.token.role == 'STAFF'
      );
    }

    function isVendor() {
      return isAuthenticated() && (
        getUserData().role == 'VENDOR' ||
        request.auth.token.role == 'VENDOR'
      );
    }

    // ── USERS Collection ───────────────────────────────────────────────
    match /users/{userId} {
      // Users can read only their own profile, Admins and Staff can read for directory/ops
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isStaff());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() || (
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
      );
      allow delete: if isAdmin();
    }

    // ── VENDORS Collection ─────────────────────────────────────────────
    match /vendors/{vendorId} {
      // Vendors can only read their own vendor profile; Admins & Staff read directory
      allow read: if isAdmin() || isStaff() || (isVendor() && getUserData().vendorId == vendorId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isVendor() &&
        getUserData().vendorId == vendorId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferredPaymentMode', 'phone', 'address', 'updatedAt'])
      );
    }

    // ── STAFF Collection ───────────────────────────────────────────────
    match /staff/{staffId} {
      // Staff can read their own record; Admins have full access
      allow read: if isAdmin() || (isStaff() && getUserData().staffId == staffId);
      allow create, delete, update: if isAdmin();
    }

    // ── PRODUCTS Collection ────────────────────────────────────────────
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── SYSTEM Collection ──────────────────────────────────────────────
    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── SUPPLIERS Collection (Confidential: Admin Only) ────────────────
    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    // ── ORDERS Collection ──────────────────────────────────────────────
    match /orders/{orderId} {
      // Vendors only see their own orders; Staff only see assigned orders; Admin sees all
      allow read: if isAdmin() ||
        (isVendor() && resource.data.vendorId == getUserData().vendorId) ||
        (isStaff() && (resource.data.assignedStaffId == getUserData().staffId || resource.data.assignedStaffId == null));
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isVendor() && request.resource.data.vendorId == getUserData().vendorId)
      );
      allow update: if isAdmin() || (
        isStaff() && resource.data.assignedStaffId == getUserData().staffId
      ) || (
        isVendor() &&
        resource.data.vendorId == getUserData().vendorId &&
        resource.data.status == 'PENDING' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'paidAmount', 'balanceDue', 'deliveryFinalized', 'actualPaymentMode',
          'totalAmount', 'subtotal', 'tax', 'invoiceId'
        ])
      );
      allow delete: if isAdmin();
    }

    // ── PAYMENTS Collection ────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isVendor() && resource.data.vendorId == getUserData().vendorId) || isStaff();
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }

    // ── LEDGER ENTRIES Collection (Immutable audit trail) ──────────────
    match /ledgerEntries/{entryId} {
      // Vendors only see their own ledger entries; Admins and Staff see all
      allow read: if isAdmin() || isStaff() || (isVendor() && resource.data.partyId == getUserData().vendorId);
      allow create: if isAdmin() || isStaff();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['editedAt', 'editedBy', 'editReason', 'amount']);
      allow delete: if false; // Immutable ledger
    }

    // ── INVOICES Collection ────────────────────────────────────────────
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || isStaff() || (isVendor() && resource.data.vendorId == getUserData().vendorId);
      allow create, update: if isAdmin() || isStaff();
      allow delete: if false;
    }

    // ── CASH SETTLEMENTS Collection ────────────────────────────────────
    match /cashSettlements/{settlementId} {
      // Staff only see their own settlements; Admin sees all
      allow read: if isAdmin() || (isStaff() && resource.data.staffId == getUserData().staffId);
      allow create: if isStaff() || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── NOTIFICATIONS Collection ───────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.targetUserId == request.auth.uid ||
        resource.data.targetRole == getUserData().role ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── AUDIT LOGS Collection (Immutable) ──────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isStaff();
      allow update, delete: if false;
    }
  }
}
